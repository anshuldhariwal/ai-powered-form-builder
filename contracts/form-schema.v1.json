{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formforge.example/contracts/form-schema.v1.json",
  "title": "FormForge Form Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "form", "steps", "conditions", "settings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "form": { "$ref": "#/$defs/form" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "settings": { "$ref": "#/$defs/settings" }
  },
  "$defs": {
    "nullableText": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "fieldKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "submit_label", "success_message"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": { "$ref": "#/$defs/nullableText" },
        "submit_label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "success_message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": { "$ref": "#/$defs/nullableText" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": { "$ref": "#/$defs/nullableText" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "key", "label", "placeholder", "help_text", "default", "required", "options", "validation"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": {
          "enum": ["text", "textarea", "number", "email", "phone", "date", "select", "radio", "checkbox", "file", "heading", "rating"]
        },
        "key": { "$ref": "#/$defs/fieldKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 255 },
        "placeholder": { "$ref": "#/$defs/nullableText" },
        "help_text": { "$ref": "#/$defs/nullableText" },
        "default": {
          "type": ["string", "number", "boolean", "array", "null"],
          "items": { "type": ["string", "number"] }
        },
        "required": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "validation": { "$ref": "#/$defs/validation" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 255 },
        "value": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_length", "max_length", "min", "max", "email", "url", "numeric", "regex", "allowed_file_types", "max_file_size_kb"],
      "properties": {
        "min_length": { "type": ["integer", "null"], "minimum": 0 },
        "max_length": { "type": ["integer", "null"], "minimum": 0 },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "email": { "type": "boolean" },
        "url": { "type": "boolean" },
        "numeric": { "type": "boolean" },
        "regex": { "type": ["string", "null"], "maxLength": 500 },
        "allowed_file_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "max_file_size_kb": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "conditionValue": {
      "type": ["string", "number", "boolean", "array", "null"],
      "items": { "type": ["string", "number"] }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_field_key", "operator", "value", "target_type", "target_id", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "source_field_key": { "$ref": "#/$defs/fieldKey" },
        "operator": { "enum": ["equals", "not_equals", "contains", "greater_than", "less_than", "is_empty", "is_not_empty"] },
        "value": { "$ref": "#/$defs/conditionValue" },
        "target_type": { "enum": ["field", "section", "step"] },
        "target_id": { "$ref": "#/$defs/stableId" },
        "action": { "enum": ["show", "hide", "require", "optional"] }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_progress", "allow_multiple_submissions"],
      "properties": {
        "show_progress": { "type": "boolean" },
        "allow_multiple_submissions": { "type": "boolean" }
      }
    }
  }
}
